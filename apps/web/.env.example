# URL del backend (apps/api)
VITE_API_URL=http://localhost:3001

# Ably (tiempo real) - opcional. Sin esto, el centro de notificaciones y el mapa
# en vivo simplemente no reciben eventos (el resto de la app funciona igual).
VITE_ABLY_API_KEY=

# Mapbox - opcional. Sin esto se muestra un aviso en vez del mapa.
VITE_MAPBOX_TOKEN=
