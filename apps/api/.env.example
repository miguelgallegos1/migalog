# Neon (Postgres serverless) - crear un proyecto/branch gratis en https://neon.tech
DATABASE_URL=postgresql://usuario:password@ep-xxxx.neon.tech/migalog?sslmode=require

# Secreto para firmar los JWT de sesión (cualquier string largo y aleatorio)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Ably (tiempo real) - free tier en https://ably.com. Si se deja vacío, el backend
# funciona igual pero no publica eventos en vivo (modo no-op, útil para probar sin costo).
ABLY_API_KEY=

# Origen permitido para CORS (la URL del frontend)
WEB_ORIGIN=http://localhost:5173

# WhatsApp Business Cloud API (Meta) - opcional para la demo, se puede simular
# el webhook directo con curl sin estas variables.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Anthropic (Claude) - si se deja vacío, el agente de IA usa reglas simples (modo $0)
# en vez de llamar a la API real.
ANTHROPIC_API_KEY=
