{
  "name": "@migalog/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/dev-server.ts",
    "build": "exit 0",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@migalog/shared": "workspace:*",
    "@neondatabase/serverless": "^0.10.1",
    "drizzle-orm": "^0.36.1",
    "hono": "^4.6.9",
    "@hono/node-server": "^1.13.5",
    "zod": "^3.23.8",
    "argon2": "^0.41.1",
    "jose": "^5.9.6",
    "nanoid": "^5.0.8",
    "ably": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "drizzle-kit": "^0.27.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
